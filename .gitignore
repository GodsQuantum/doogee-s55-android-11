# Machine-specific handoffs: contain local paths, device identifiers and private state
HANDOFF_CURRENT.md
HANDOFF_*.md
PROMPT_NEW_SESSION_*.md

# Generated/local backups
backups/*
# Self-contained OFFLINE flash kit: OEM/Google/boot/vendor images MUST NOT be in Git
local-kit/
local-kit-*/
local-s55-test-*/
local-s55-lint/
installer/local-kit/
private-install-state/
local-stock-inspect-tmp/
**/__pycache__/
*.pyc
!backups/.gitignore

# Third-party device artifacts are local-only
files/*
!files/README.md

# Large/downloaded/generated artifacts
*.img
*.img.xz
*.img.gz
*.zip
*.zip.tmp
*.7z
platform-tools*/
