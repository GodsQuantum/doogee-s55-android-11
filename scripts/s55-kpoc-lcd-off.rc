# Android init event order: init runs before charger class_start.
# Give the system-UID MediaTek light helper DAC access BEFORE its first run.
# This is the same owner/mode as stock Android's active lcd-backlight sysfs.
on init
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

# Class charger is required for KPOC lifecycle, but automatic start is NOT:
# start this helper ONLY after s55_kpoc_bridge exits, when graphics is ready.
# SELinux executable must be mtk_hal_light_exec (OEM light HAL domain).
# Reasserts LED0 after bridge exits (0, 450, 1100 ms), then exits.
service s55_kpoc_lcd_off /vendor/bin/s55_kpoc_lcd_off
    class charger
    disabled
    oneshot
    user system
    group system graphics
    seclabel u:r:mtk_hal_light:s0

# FB powerdown waits until LED helper completes all three writes.
# The charger domain already handles fb0 IOCTLs in KPOC.
on property:init.svc.s55_kpoc_lcd_off=stopped
    start s55_kpoc_fb_off
