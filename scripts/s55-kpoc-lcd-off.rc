# S55 KPOC LED helper starts as class charger, no property-only dependency.
# SELinux executable must be mtk_hal_light_exec (OEM light HAL domain).
# Reasserts LED0 at startup (0, 450, 1100 ms), then exits; no daemon.
service s55_kpoc_lcd_off /vendor/bin/s55_kpoc_lcd_off
    class charger
    oneshot
    user system
    group system graphics
    seclabel u:r:mtk_hal_light:s0

# FB powerdown waits until LED helper completes all three writes.
# The charger domain already handles fb0 IOCTLs in KPOC.
on property:init.svc.s55_kpoc_lcd_off=stopped
    start s55_kpoc_fb_off
