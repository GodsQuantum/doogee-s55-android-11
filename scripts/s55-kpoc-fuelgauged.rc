# S55 KPOC: use static OEM fuel gauge with existing fuelgauged_exec label.
# Starts in KPOC class only; does not restart if the daemon exits.
# No change to Android normal main-class vendor fuelgauged service.
service s55_kpoc_fuelgauged /vendor/bin/s55_kpoc_fuelgauged_static
    class charger
    user root
    group root
    seclabel u:r:fuelgauged:s0
    oneshot
