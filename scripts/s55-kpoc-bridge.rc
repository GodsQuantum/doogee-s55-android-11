# DOOGEE S55 KPOC only: proprietary GSI/MTK charge display bridge.
# OEM order: BLACK immediately -> LED0 in MTK light domain -> FBIOBLANK(4).
# Bridge oneshot exits immediately; LCD helper starts first on exit.
# Do not set backlight after the framebuffer becomes DISP_SLEPT.
# Power key, charger current and thermal protection stay with stock kernel.
service s55_kpoc_bridge /vendor/bin/s55_kpoc_bridge
    class charger
    user root
    group root graphics input
    seclabel u:r:charger:s0
    oneshot

on property:init.svc.s55_kpoc_bridge=stopped
    start s55_kpoc_lcd_off
