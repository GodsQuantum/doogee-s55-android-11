# DOOGEE S55 KPOC only: proprietary GSI/MTK charge display bridge.
# Bridge is deliberately oneshot: draws battery for 6s then exits after 8s.
# When init sets init.svc.s55_kpoc_bridge=stopped, built-in write executes in
# init SELinux domain, avoiding charger-domain denial on generic sysfs label.
# Only LCD brightness is written. Never touch charge safety or thermals.
service s55_kpoc_bridge /vendor/bin/s55_kpoc_bridge
    class charger
    user root
    group root graphics input
    seclabel u:r:charger:s0
    oneshot

on property:init.svc.s55_kpoc_bridge=stopped
    start s55_kpoc_lcd_off
